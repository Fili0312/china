# --- Database & code ---------------------------------------------------------
DATABASE_URL="postgresql://china:china@localhost:5432/china_sourcing"
REDIS_URL="redis://localhost:6379"

# --- Claude API ---------------------------------------------------------------
# Chiave dell'API Claude. Vive SOLO nel processo server: non viene mai
# restituita da un'API, scritta in un log o salvata a database.
# ANTHROPIC_API_KEY resta accettata (e ha la precedenza se CLAUDE_API_KEY manca).
CLAUDE_API_KEY=""
CLAUDE_MODEL="claude-opus-4-8"
# AI_MOCK=1 salta le chiamate Claude e usa un parser/matcher finto (solo dev/test).
# Vale per la pipeline preventivi, NON per l'analisi delle richieste: un'analisi
# finta produrrebbe chiavi di variante finte, che poi deciderebbero il riuso di
# prodotti veri. Senza chiave l'analisi fallisce e lo dice.
AI_MOCK=0

# --- Analisi delle richieste con Claude ------------------------------------------
# Righe per chiamata. Il prompt di sistema (~2000 token) si paga a ogni
# chiamata: lotti piu grandi lo diluiscono. Default 10.
# ANALYSIS_BATCH_SIZE=10
# Profondita di ragionamento: low | medium | high. Default low — l'estrazione
# strutturata non ne ha bisogno, e il ragionamento e la voce che costa.
# ANALYSIS_EFFORT=low
# Chiamate contemporanee. Default 2: basso di proposito, per non saturare i limiti.
# ANALYSIS_CONCURRENCY=2
# Timeout della singola chiamata, in millisecondi. Default 120000.
# ANALYSIS_TIMEOUT_MS=120000
# Sotto questa confidenza la riga non parte da sola: va confermata a mano
# nella fase di revisione. Default 0.65.
# ANALYSIS_MIN_CONFIDENCE=0.65

# --- Marketplace ---------------------------------------------------------------
# Elenco adapter attivi, separati da virgola. Disponibili: mock, alibaba,
# aliexpress, made-in-china, chinagoods, yiwugo
# "mock" genera risultati finti deterministici: utile per testare la pipeline
# senza scraping. In produzione, scegli soltanto gli adapter necessari.
MARKETPLACES=mock
PLAYWRIGHT_HEADLESS=1
SEARCH_CONCURRENCY=3
MAX_CANDIDATES_PER_MARKETPLACE=8

# --- OTAPI (cataloghi Taobao/Tmall separati tramite feature reale) ---------------
# Chiave istanza OpenTrade Commerce: solo lato server, mai nel frontend/repo.
OTAPI_INSTANCE_KEY=""
# Timeout della chiamata OTAPI in ms (default 45000: a cache fredda serve ~20s)
# OTAPI_TIMEOUT_MS=45000
# Cache delle ricerche OTAPI identiche (riduce chiamate a consumo), default 5m.
# OTAPI_CACHE_TTL_MS=300000

# Cache e pausa anti-bot per le fonti interrogate via browser
# (Alibaba, AliExpress, Made-in-China). Valori in millisecondi.
# SCRAPER_CACHE_TTL_MS=900000
# SCRAPER_CAPTCHA_COOLDOWN_MS=600000
# Numero di risultati pre-caricati anche se il bulk ne chiede meno.
# SCRAPER_CACHE_FILL_SIZE=10
# Limiti di protezione per code browser e richieste API concorrenti.
# SCRAPER_MAX_PENDING=50
# SEARCH_MAX_IN_FLIGHT=12
# SEARCH_RATE_LIMIT_PER_MINUTE=120
# Ranking deterministico (0-100). Strict è il profilo predefinito della UI.
# SEARCH_RELEVANCE_STRICT_THRESHOLD=70
# SEARCH_RELEVANCE_BALANCED_THRESHOLD=55
# SEARCH_RELEVANCE_BROAD_THRESHOLD=40
# Candidati recuperati per le fonti browser prima di filtrare (max 50).
# SEARCH_STRICT_FETCH_SIZE=30
# Origini frontend aggiuntive autorizzate, separate da virgola.
# CORS_ORIGINS=https://esempio.it

# --- Piloterr (Alibaba/AliExpress via API, aggira il captcha del VPS) ----------
# Chiave API Piloterr: solo lato server, mai nel frontend, nei log o nel repo.
# Il valore reale va scritto in .env.local / .env, non qui.
PILOTERR_API_KEY=
# Timeout della chiamata Piloterr in ms (default 30000).
# PILOTERR_TIMEOUT_MS=30000
# Cache delle risposte Piloterr identiche: ogni chiamata consuma crediti.
# PILOTERR_CACHE_TTL_MS=3600000
# Tetto di chiamate per processo, come protezione di spesa (0 = nessun limite).
# PILOTERR_MAX_CALLS_PER_RUN=0

# --- Scouting da file (Excel/XLS/CSV) -------------------------------------------
# Dimensione massima del file caricato (default 25 MB).
# SCOUTING_MAX_UPLOAD_BYTES=26214400
# Dopo quanti giorni una richiesta gia elaborata viene ricercata da capo.
# (percorso senza analisi IA)
# SCOUTING_REFRESH_AFTER_DAYS=14

# --- Riuso dei prodotti gia trovati ----------------------------------------------
# Un link salvato mesi fa non e una risposta: queste soglie decidono quando i
# prodotti noti bastano e quando si rifa la ricerca completa.
#
# Durata massima della cache di un prodotto: oltre questa eta l'ultima verifica
# e considerata scaduta. Default 336 ore (14 giorni).
# SCOUTING_PRODUCT_CACHE_HOURS=336
# Variazione percentuale di prezzo oltre la quale il prodotto va ricercato di
# nuovo (vale in entrambe le direzioni). Default 25.
# SCOUTING_MAX_PRICE_CHANGE_PCT=25
# Numero minimo di prodotti ancora validi per poter riusare invece di cercare.
# Sotto questa soglia si rifa la ricerca completa. Default 2.
# SCOUTING_MIN_VALID_CANDIDATES=2
# Se l'aggiornamento di un prodotto fallisce, considerarlo non valido e rifare
# la ricerca invece di fidarsi del dato vecchio. Default attivo (1).
# SCOUTING_FULL_SEARCH_ON_ERROR=1

# --- Sessioni account (1688, Taobao) ---------------------------------------------
# Segreto per cifrare i cookie degli account collegati (AES-256-GCM).
# Genera 32 byte casuali:  openssl rand -hex 32
# Senza questo valore le sessioni non possono essere salvate.
SCOUTING_SESSION_SECRET=

# --- Preventivo -----------------------------------------------------------------
# Ricarico di default in percentuale (override per singola richiesta via API/UI)
MARKUP_DEFAULT_PCT=30
QUOTE_CURRENCY=USD

# --- Porte -----------------------------------------------------------------------
API_PORT=3021
# URL dell'API visto dal browser (dashboard)
NEXT_PUBLIC_API_URL=http://localhost:3021

# --- Scouting v1: solo Taobao, per cliente (/scouting-v1) --------------------
# Ricerca via Taobao DataHub su RapidAPI. Senza chiave la ricerca API non è
# disponibile: nessun risultato viene simulato.
RAPIDAPI_KEY=
TAOBAO_DATAHUB_HOST=taobao-datahub.p.rapidapi.com

# Percorsi e nomi degli endpoint, configurabili perché i fornitori RapidAPI li
# cambiano fra una revisione e l'altra. `GET /api/taobao/api/status` mostra
# quelli realmente in uso.
# Percorsi verificati: l'endpoint e il path stesso, nessun parametro api=.
# TAOBAO_DATAHUB_SEARCH_PATH=/item_search
# TAOBAO_DATAHUB_DETAIL_PATH=/item_detail
# TAOBAO_DATAHUB_REVIEW_PATH=/item_review
# Vuoto = nessun parametro api= (il caso di questa sottoscrizione).
# TAOBAO_DATAHUB_SEARCH_API=
# TAOBAO_DATAHUB_QUERY_PARAM=q
# TAOBAO_DATAHUB_ITEM_PARAM=itemId

# Cache delle risposte: i crediti si pagano una volta sola.
# TAOBAO_DATAHUB_CACHE_HOURS=168
# TAOBAO_DATAHUB_TIMEOUT_MS=30000

# Ricerca browser con l'account collegato.
# TAOBAO_BROWSER_TIMEOUT_MS=45000
# TAOBAO_BROWSER_COOLDOWN_MS=900000

# Riuso dei prodotti già conosciuti.
# TAOBAO_PRODUCT_CACHE_HOURS=336
# TAOBAO_MAX_PRICE_CHANGE_PCT=25
# TAOBAO_MIN_VALID_PRODUCTS=2

# Sotto questa confidenza la riga non parte da sola nella revisione.
# TAOBAO_MIN_CONFIDENCE=0.45
# TAOBAO_REFRESH_LIMIT=12

# --- ElimAPI: seconda fonte (Taobao + 1688) ---------------------------------
# Chiave inviata nell'header `x-api-key`. Senza, la riserva non è disponibile.
ELI_API=
ELI_API_BASE_URL=https://openapi.elim.asia/v1
# Sotto questo numero di risultati DataHub "non basta" e parte ElimAPI.
# ELIM_MIN_RESULTS=3
# ELIM_CACHE_HOURS=168
# ELIM_TIMEOUT_MS=30000
# ELIM_MAX_ATTEMPTS=2
# ELIM_RETRY_MS=1500

# --- Analisi Excel: provider alternativo DeepSeek ------------------------
# Motore dell'analisi delle righe: claude (default) oppure deepseek.
# Nessun fallback automatico: se il motore scelto fallisce, le righe
# falliscono con il suo errore.
AI_ANALYSIS_PROVIDER=claude
# Chiave DeepSeek (endpoint OpenAI-compatible). Mai nel frontend o nei log.
DEEP_SEEK_API=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Modello chat non-reasoning attuale (deepseek-chat è deprecato dal 2026-07-24).
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=60000
# Tetto di spesa complessivo del test DeepSeek, in dollari: raggiunto il
# limite, i lotti successivi non partono e le righe dicono il residuo.
DEEPSEEK_TEST_BUDGET_USD=2
# Listino per la stima dei costi ($/M token), correggibile senza toccare codice.
#DEEPSEEK_PRICE_INPUT_MTOK=0.14
#DEEPSEEK_PRICE_CACHE_HIT_MTOK=0.0028
#DEEPSEEK_PRICE_OUTPUT_MTOK=0.28
# Pipeline profonda DeepSeek: seconda passata di revisione (1 = attiva) e
# righe per chiamata (lotti piccoli = più attenzione per riga, costa comunque
# centesimi). Claude non è toccato da queste due variabili.
DEEPSEEK_REFINE=1
DEEPSEEK_ANALYSIS_BATCH_SIZE=6

# --- Ricerca Taobao: fonte primaria -------------------------------------
# hwh = «Taobao API by H-W-H» su RapidAPI (stessa RAPIDAPI_KEY, piano
# separato); datahub = ordine vecchio. DataHub resta comunque il fallback
# della ricerca e l'unico per dettagli/recensioni.
TAOBAO_PRIMARY_SEARCH=hwh
#HWH_HOST=taobao-api.p.rapidapi.com
#HWH_SEARCH_PATH=/api
#HWH_API_NAME=item_search
#HWH_PAGE_SIZE=20
#HWH_SORT=default
#HWH_TIMEOUT_MS=30000
#HWH_CACHE_HOURS=168
# Fallback DataHub della ricerca quando H-W-H è primaria (1 = attivo).
# 0 = solo Taobao API cerca (fonti secondarie in standby, nessun errore di
# fallback mostrato durante una demo).
TAOBAO_SEARCH_FALLBACK=0

# Motore della seconda passata (verifica coerenza): deepseek (default) o claude.
AI_VERIFY_PROVIDER=deepseek
