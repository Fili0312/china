{
  "name": "@china/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:search": "tsx --test src/search/*.test.ts src/inquiry/*.test.ts",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "tsx --test src/search/*.test.ts src/inquiry/*.test.ts src/scouting/*.test.ts"
  },
  "dependencies": {
    "@china/adapters": "workspace:*",
    "@china/db": "workspace:*",
    "@china/shared": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "bullmq": "^5.80.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "0.18.5",
    "zod": "^4.4.3"
  }
}
