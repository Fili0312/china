generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  RECEIVED // creata, in coda per il parsing
  PARSING // Claude sta estraendo la lista strutturata
  SEARCHING // fan-out ricerche sui marketplace
  ASSEMBLING // fan-in: calcolo preventivo
  READY // preventivo pronto
  FAILED
}

enum ItemStatus {
  PENDING
  SEARCHING
  MATCHING // selezione AI dei candidati migliori
  SELECTED
  NO_RESULTS // nessun candidato trovato/adeguato: da quotare a mano
  FAILED
}

model QuoteRequest {
  id        String        @id @default(cuid())
  rawText   String
  status    RequestStatus @default(RECEIVED)
  markupPct Float
  currency  String        @default("USD")
  error     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items RequestItem[]
  quote Quote?
}

model RequestItem {
  id        String       @id @default(cuid())
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  position  Int

  name       String
  quantity   Int
  color      String?
  size       String?
  attributes Json?
  notes      String?

  queryEn String?
  queryZh String?

  status ItemStatus @default(PENDING)
  error  String?

  candidates ProductCandidate[]

  @@index([requestId])
}

model ProductCandidate {
  id     String      @id @default(cuid())
  item   RequestItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  marketplace String
  externalId  String // id opaco lato adapter (per gli scraper: l'URL prodotto)
  title       String
  url         String
  imageUrl    String?

  priceValue    Decimal? @db.Decimal(12, 4)
  priceCurrency String?
  moq           Int?
  raw           Json?

  // Valorizzati dal passo di matching AI (solo per i candidati scelti)
  selectedRank Int? // 1 = scelta principale, 2-3 alternative
  score        Float?
  reason       String?
  variant      String?

  createdAt DateTime @default(now())

  @@unique([itemId, marketplace, externalId])
  @@index([itemId])
}

model Quote {
  id        String       @id @default(cuid())
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String       @unique

  currency   String
  markupPct  Float
  totalCost  Decimal @db.Decimal(14, 2)
  totalPrice Decimal @db.Decimal(14, 2)

  createdAt DateTime    @default(now())
  lines     QuoteLine[]
}

model QuoteLine {
  id      String @id @default(cuid())
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String

  itemId      String
  candidateId String?

  description String
  quantity    Int
  unitCost    Decimal @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(12, 4)
  lineTotal   Decimal @db.Decimal(14, 2)

  marketplace String?
  url         String?
  imageUrl    String?
  moq         Int?
  variant     String?
  note        String?

  @@index([quoteId])
}

/// ---------------------------------------------------------------------------
/// Scouting prodotti multi-marketplace da file (Excel/XLS/CSV).
///
/// Blocco additivo: nessun modello preesistente viene modificato. La pipeline
/// preventivi (QuoteRequest/RequestItem/ProductCandidate) resta intatta.
///
/// Gerarchia: un file caricato (ScoutingDataset) genera un ImportJob; ogni
/// riga del job punta alla ScoutingRequest identificata dalla sua impronta,
/// quindi righe duplicate — nello stesso file o in file diversi — condividono
/// la stessa richiesta e gli stessi candidati.
/// ---------------------------------------------------------------------------

enum ImportJobStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ScoutingRowStatus {
  PENDING
  SEARCHING
  REFRESHING
  SCORING
  DONE
  SKIPPED
  FAILED
  CANCELLED
}

enum ScoutingEngineStatus {
  PENDING
  RUNNING
  DONE
  ERROR
  SKIPPED
}

enum ScoutingOutcome {
  FINALIST
  SHORTLISTED
  REJECTED
}

/// Un file caricato dall'utente, con le colonne riconosciute.
model ScoutingDataset {
  id        String   @id @default(cuid())
  fileName  String
  format    String // xlsx | xls | xlsm | csv
  sheetName String
  sizeBytes Int

  /// Riga di intestazione nel file (1-based); null se il file non ne ha.
  headerRowNumber Int?
  /// Colonne riconosciute (DatasetColumn[]), con campioni e suggerimenti.
  columns         Json
  /// Ultima mappatura colonna→campo confermata dall'utente.
  mapping         Json?
  rowCount        Int
  warnings        String[]

  createdAt DateTime @default(now())

  rows ScoutingDatasetRow[]
  jobs ImportJob[]
}

/// Riga originale del file: i valori delle celle restano intatti.
model ScoutingDatasetRow {
  id        String          @id @default(cuid())
  dataset   ScoutingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String

  /// Numero di riga nel file di origine (1-based).
  rowNumber Int
  /// Valori originali, allineati a ScoutingDataset.columns.
  cells     Json
  hyperlink String?

  jobRows ImportJobRow[]

  @@unique([datasetId, rowNumber])
  @@index([datasetId])
}

/// Richiesta normalizzata: identità stabile fra file, righe e formulazioni.
model ScoutingRequest {
  id String @id @default(cuid())

  /// Impronta stabile (SHA-256 troncato): identità forte della richiesta.
  fingerprint       String  @unique
  /// Identità debole, per proporre richieste simili già elaborate.
  normalizedNameKey String
  displayName       String
  normalizedName    String

  category String?
  brand    String?
  model    String?
  material String?
  power    Float?
  voltage  Float?
  capacity Float?

  dimensions      Json
  requiredVariant Json
  certifications  String[]
  requirements    Json

  requestedQuantity Float?
  unit              String?
  targetPrice       Float?
  notes             String?
  referenceUrl      String?

  searchQuery String
  language    String

  firstSeenAt    DateTime  @default(now())
  lastSearchedAt DateTime?
  searchCount    Int       @default(0)

  candidates ProductCandidateRecord[]
  jobRows    ImportJobRow[]

  @@index([normalizedNameKey])
}

/// L'elaborazione di un file: una per avvio, con la propria configurazione.
model ImportJob {
  id        String          @id @default(cuid())
  dataset   ScoutingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String

  status  ImportJobStatus @default(QUEUED)
  engines String[]
  quality String          @default("balanced")

  candidatesPerEngine Int     @default(10)
  finalists           Int     @default(3)
  forceFullSearch     Boolean @default(false)
  aiRationale         Boolean @default(false)
  /// Mappatura usata da questo job: i risultati restano leggibili anche se
  /// la mappatura del dataset viene cambiata in seguito.
  mapping             Json

  totalRows     Int @default(0)
  processedRows Int @default(0)
  reusedRows    Int @default(0)
  failedRows    Int @default(0)

  /// Crediti Piloterr consumati da questo job (0 se la chiave non è attiva).
  creditsSpent Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  rows ImportJobRow[]

  @@index([datasetId])
  @@index([status])
}

/// Avanzamento e risultato di una singola riga dentro un job.
model ImportJobRow {
  id    String    @id @default(cuid())
  job   ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  datasetRow   ScoutingDatasetRow @relation(fields: [datasetRowId], references: [id], onDelete: Cascade)
  datasetRowId String

  request   ScoutingRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestId String?

  rowNumber   Int
  displayName String
  searchQuery String
  status      ScoutingRowStatus @default(PENDING)
  /// true quando i prodotti arrivano da una richiesta già elaborata.
  reused      Boolean           @default(false)
  error       String?

  startedAt  DateTime?
  finishedAt DateTime?

  engines ImportJobRowEngine[]
  results ScoutingResult[]

  @@unique([jobId, datasetRowId])
  @@index([jobId, status])
  @@index([requestId])
}

/// Esito della riga su un singolo marketplace: stato, conteggi ed errore
/// restano separati per fonte, così un captcha su Alibaba non nasconde i
/// risultati validi di Yiwugo e si può ritentare solo la fonte fallita.
model ImportJobRowEngine {
  id       String       @id @default(cuid())
  jobRow   ImportJobRow @relation(fields: [jobRowId], references: [id], onDelete: Cascade)
  jobRowId String

  engine String
  status ScoutingEngineStatus @default(PENDING)

  /// Query realmente inviata alla fonte (può differire da quella richiesta).
  queryUsed      String?
  fetchedCount   Int     @default(0)
  acceptedCount  Int     @default(0)
  durationMs     Int     @default(0)
  /// Codice tipizzato dell'errore (SOURCE_UPSTREAM, SOURCE_BUSY, …).
  errorCode      String?
  error          String?
  retryable      Boolean @default(false)
  attempts       Int     @default(0)
  /// true se i risultati provengono dalla cache e non hanno speso crediti.
  servedFromCache Boolean @default(false)

  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([jobRowId, engine])
  @@index([jobRowId])
}

/// Prodotto trovato per una richiesta. Vive oltre il singolo job: è ciò che
/// permette di riaprire le pagine e aggiornare i dati invece di ricercare.
model ProductCandidateRecord {
  id        String          @id @default(cuid())
  request   ScoutingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String

  engine     String
  externalId String
  url        String?
  title      String
  imageUrl   String?

  /// Query che ha fatto emergere questo candidato: serve a capire perché è
  /// stato trovato e a rieseguire la stessa ricerca in fase di aggiornamento.
  foundQuery String

  vendorName String?
  vendorUrl  String?

  price       Decimal? @db.Decimal(14, 4)
  currency    String?
  moq         Int?
  stock       Int?
  rating      Float?
  reviewCount Int?
  totalSales  Int?

  variants   Json?
  specs      Json?
  priceTiers Json?

  /// Punteggio di pertinenza calcolato dal motore già esistente.
  relevanceScore Float?
  matchReasons   String[]
  matchWarnings  String[]

  /// Impronta dei dati commerciali: se non cambia, il punteggio non si ricalcola.
  contentHash   String
  firstSeenAt   DateTime  @default(now())
  lastCheckedAt DateTime  @default(now())
  lastChangedAt DateTime?
  /// Campi cambiati all'ultimo aggiornamento.
  changedFields String[]
  /// Dettaglio prodotto già scaricato almeno una volta (M6).
  detailsFetchedAt DateTime?
  /// Prodotto non più raggiungibile all'ultimo controllo.
  unavailable   Boolean   @default(false)

  snapshots ProductSnapshot[]
  results   ScoutingResult[]

  @@unique([requestId, engine, externalId])
  @@index([requestId])
  @@index([requestId, engine])
}

/// Storico: una riga per ogni cambiamento reale dei dati del prodotto.
model ProductSnapshot {
  id          String                 @id @default(cuid())
  candidate   ProductCandidateRecord @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  capturedAt DateTime @default(now())

  price       Decimal? @db.Decimal(14, 4)
  currency    String?
  moq         Int?
  stock       Int?
  rating      Float?
  reviewCount Int?
  available   Boolean  @default(true)

  contentHash   String
  changedFields String[]

  @@index([candidateId, capturedAt])
}

/// Esito di un prodotto per una riga: finalista o scartato, con motivazione.
model ScoutingResult {
  id       String       @id @default(cuid())
  jobRow   ImportJobRow @relation(fields: [jobRowId], references: [id], onDelete: Cascade)
  jobRowId String

  candidate   ProductCandidateRecord @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  outcome ScoutingOutcome
  rank    Int?
  score   Float?
  /// Contributo di ogni criterio al punteggio finale.
  scoreBreakdown Json?

  rejectionCode   String?
  rejectionReason String?
  aiRationale     String?
  /// true se il punteggio è stato riusato perché i dati non sono cambiati.
  scoreReused     Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([jobRowId, candidateId])
  @@index([jobRowId])
}

/// Sessione di un marketplace che richiede login (1688, Taobao).
///
/// I cookie sono credenziali: stanno qui **solo cifrati** (AES-256-GCM) e non
/// vengono mai restituiti da un'API né scritti nei log. Di ogni sessione si
/// espone soltanto lo stato: quale account, quando scade, quando è stata usata.
model MarketplaceSession {
  id          String @id @default(cuid())
  marketplace String @unique

  /// Etichetta scelta dall'utente per riconoscere l'account.
  label String?

  /// Blob cifrato dei cookie, con il proprio vettore e tag di autenticazione.
  ciphertext String
  iv         String
  authTag    String
  /// Impronta del contenuto: dice se la sessione è cambiata senza esporla.
  digest     String

  /// Nomi dei cookie presenti, senza valori: utile per diagnosticare.
  cookieNames String[]
  /// Scadenza dichiarata dai cookie stessi, quando presente.
  expiresAt   DateTime?

  lastUsedAt   DateTime?
  lastFailedAt DateTime?
  /// Motivo dell'ultimo fallimento: serve a capire se va ricollegata.
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
