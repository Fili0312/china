generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  RECEIVED // creata, in coda per il parsing
  PARSING // Claude sta estraendo la lista strutturata
  SEARCHING // fan-out ricerche sui marketplace
  ASSEMBLING // fan-in: calcolo preventivo
  READY // preventivo pronto
  FAILED
}

enum ItemStatus {
  PENDING
  SEARCHING
  MATCHING // selezione AI dei candidati migliori
  SELECTED
  NO_RESULTS // nessun candidato trovato/adeguato: da quotare a mano
  FAILED
}

model QuoteRequest {
  id        String        @id @default(cuid())
  rawText   String
  status    RequestStatus @default(RECEIVED)
  markupPct Float
  currency  String        @default("USD")
  error     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items RequestItem[]
  quote Quote?
}

model RequestItem {
  id        String       @id @default(cuid())
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  position  Int

  name       String
  quantity   Int
  color      String?
  size       String?
  attributes Json?
  notes      String?

  queryEn String?
  queryZh String?

  status ItemStatus @default(PENDING)
  error  String?

  candidates ProductCandidate[]

  @@index([requestId])
}

model ProductCandidate {
  id     String      @id @default(cuid())
  item   RequestItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  marketplace String
  externalId  String // id opaco lato adapter (per gli scraper: l'URL prodotto)
  title       String
  url         String
  imageUrl    String?

  priceValue    Decimal? @db.Decimal(12, 4)
  priceCurrency String?
  moq           Int?
  raw           Json?

  // Valorizzati dal passo di matching AI (solo per i candidati scelti)
  selectedRank Int? // 1 = scelta principale, 2-3 alternative
  score        Float?
  reason       String?
  variant      String?

  createdAt DateTime @default(now())

  @@unique([itemId, marketplace, externalId])
  @@index([itemId])
}

model Quote {
  id        String       @id @default(cuid())
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String       @unique

  currency   String
  markupPct  Float
  totalCost  Decimal @db.Decimal(14, 2)
  totalPrice Decimal @db.Decimal(14, 2)

  createdAt DateTime    @default(now())
  lines     QuoteLine[]
}

model QuoteLine {
  id      String @id @default(cuid())
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String

  itemId      String
  candidateId String?

  description String
  quantity    Int
  unitCost    Decimal @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(12, 4)
  lineTotal   Decimal @db.Decimal(14, 2)

  marketplace String?
  url         String?
  imageUrl    String?
  moq         Int?
  variant     String?
  note        String?

  @@index([quoteId])
}

/// ---------------------------------------------------------------------------
/// Scouting prodotti multi-marketplace da file (Excel/XLS/CSV).
///
/// Blocco additivo: nessun modello preesistente viene modificato. La pipeline
/// preventivi (QuoteRequest/RequestItem/ProductCandidate) resta intatta.
///
/// Gerarchia: un file caricato (ScoutingDataset) genera un ImportJob; ogni
/// riga del job punta alla ScoutingRequest identificata dalla sua impronta,
/// quindi righe duplicate — nello stesso file o in file diversi — condividono
/// la stessa richiesta e gli stessi candidati.
/// ---------------------------------------------------------------------------

enum ImportJobStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ScoutingRowStatus {
  PENDING
  SEARCHING
  REFRESHING
  SCORING
  DONE
  SKIPPED
  FAILED
  CANCELLED
}

enum ScoutingEngineStatus {
  PENDING
  RUNNING
  DONE
  ERROR
  SKIPPED
}

enum ScoutingOutcome {
  FINALIST
  SHORTLISTED
  REJECTED
}

/// Un file caricato dall'utente, con le colonne riconosciute.
model ScoutingDataset {
  id        String   @id @default(cuid())
  fileName  String
  format    String // xlsx | xls | xlsm | csv
  sheetName String
  sizeBytes Int

  /// Riga di intestazione nel file (1-based); null se il file non ne ha.
  headerRowNumber Int?
  /// Colonne riconosciute (DatasetColumn[]), con campioni e suggerimenti.
  columns         Json
  /// Ultima mappatura colonna→campo confermata dall'utente.
  mapping         Json?
  rowCount        Int
  warnings        String[]

  createdAt DateTime @default(now())

  rows         ScoutingDatasetRow[]
  jobs         ImportJob[]
  analysisRuns AnalysisRun[]
}

/// Riga originale del file: i valori delle celle restano intatti.
model ScoutingDatasetRow {
  id        String          @id @default(cuid())
  dataset   ScoutingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String

  /// Numero progressivo della riga nel dataset (1-based).
  ///
  /// Con più fogli importati insieme non può essere il numero di riga del
  /// foglio: due fogli hanno entrambi una riga 6. L'origine reale — quella
  /// che l'utente ritrova aprendo Excel — sta in `sheetName`+`sheetRowNumber`.
  rowNumber Int
  /// Foglio di provenienza.
  sheetName      String @default("")
  /// Riga nel foglio di origine (1-based).
  sheetRowNumber Int    @default(0)
  /// Valori originali, allineati a ScoutingDataset.columns.
  cells     Json
  hyperlink String?

  jobRows      ImportJobRow[]
  analysisRows AnalysisRunRow[]

  @@unique([datasetId, rowNumber])
  @@index([datasetId])
}

/// Richiesta normalizzata: identità stabile fra file, righe e formulazioni.
model ScoutingRequest {
  id String @id @default(cuid())

  /// Impronta stabile (SHA-256 troncato): identità forte della richiesta.
  ///
  /// Resta la chiave del percorso senza analisi IA (import diretto, job già
  /// salvati). Con l'analisi attiva l'identità è `variantKey`: l'impronta
  /// continua a essere calcolata e salvata, ma non decide più il riuso.
  fingerprint       String  @unique
  /// Identità debole, per proporre richieste simili già elaborate.
  normalizedNameKey String
  displayName       String
  normalizedName    String

  /// ------------------------------------------------------------------
  /// Identità a tre livelli (dall'analisi Claude).
  ///
  /// Nullable perché le richieste create prima dell'analisi IA non le hanno:
  /// il riuso ricade sull'impronta, come prima. `variantKey` è unica quando
  /// presente — in Postgres più `NULL` non collidono fra loro.
  /// ------------------------------------------------------------------
  familyKey    String?
  variantKey   String? @unique
  duplicateKey String?

  productNameChinese String?
  productNameEnglish String?
  searchQueryChinese String?
  searchQueryEnglish String?

  /// Ultima volta che i prodotti di questa variante sono stati riletti alla
  /// fonte. Diverso da `lastSearchedAt`: quella è l'ultima **ricerca**, questa
  /// l'ultima **verifica** di ciò che avevamo già.
  lastVerifiedAt DateTime?

  category String?
  brand    String?
  model    String?
  material String?
  power    Float?
  voltage  Float?
  capacity Float?

  dimensions      Json
  requiredVariant Json
  certifications  String[]
  requirements    Json

  requestedQuantity Float?
  unit              String?
  targetPrice       Float?
  notes             String?
  referenceUrl      String?

  searchQuery String
  language    String

  firstSeenAt    DateTime  @default(now())
  lastSearchedAt DateTime?
  searchCount    Int       @default(0)

  candidates ProductCandidateRecord[]
  jobRows    ImportJobRow[]

  @@index([normalizedNameKey])
  @@index([familyKey])
  @@index([duplicateKey])
}

/// ---------------------------------------------------------------------------
/// Analisi delle richieste con Claude.
///
/// La memoria del sistema vive qui, non nella conversazione: ogni analisi è un
/// record con la versione del prompt e il modello che l'hanno prodotta. Prima
/// di richiamare l'API si cerca in `RequestAnalysis` la stessa riga
/// normalizzata analizzata con la stessa versione del prompt; se c'è, la
/// chiamata non si fa.
/// ---------------------------------------------------------------------------

enum AnalysisRowState {
  NEW_PRODUCT
  NEW_VARIANT
  KNOWN_PRODUCT
  NEEDS_REVIEW
  ANALYSIS_FAILED
  READY
}

/// Analisi di una riga, riusabile fra file e sessioni diverse.
///
/// La chiave è (testo normalizzato, versione prompt, modello): cambiare il
/// prompt o il modello produce una nuova analisi invece di sporcare quella
/// vecchia, così si può confrontare il prima e il dopo.
model RequestAnalysis {
  id String @id @default(cuid())

  /// SHA-256 del testo inviato: la riga stessa non viene usata come chiave
  /// perché può essere lunga e contenere caratteri di ogni scrittura.
  inputHash     String
  promptVersion String
  model         String

  /// Chi ha prodotto l'analisi: `claude` o `deepseek`. Fa parte della chiave
  /// di cache: un'analisi Claude non è mai una risposta DeepSeek — le due
  /// convivono per la stessa riga, ed è ciò che permette di confrontarle
  /// senza rifare chiamate.
  provider String @default("claude")

  /// Testo effettivamente inviato a Claude, conservato per poter rispiegare
  /// **su cosa** è stata fatta l'analisi (e per riprodurla).
  submittedText String

  /// Risultato validato con Zod (`ProductAnalysis`); `null` se l'analisi è
  /// fallita — anche i fallimenti si memorizzano, per non ritentare in loop.
  analysis Json?
  ok       Boolean @default(true)
  error    String?

  familyKey    String?
  variantKey   String?
  duplicateKey String?
  confidence   Float?

  /// Consumo della chiamata che ha prodotto questa analisi. Con un batch, i
  /// token sono già ripartiti fra le righe che ne facevano parte.
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  costUsd      Float @default(0)

  createdAt DateTime @default(now())

  rows AnalysisRunRow[]
  /// Righe dello scouting v1 (solo Taobao) che riusano la stessa analisi: la
  /// cache è condivisa fra i due flussi, ed è il motivo per cui rianalizzare
  /// un file già visto non costa nulla anche cambiando pagina.
  taobaoRows TaobaoAnalysisRow[]

  @@unique([inputHash, promptVersion, model, provider])
  @@index([variantKey])
}

/// Una sessione di analisi su un file: è ciò che l'utente rivede prima di
/// avviare lo scouting.
model AnalysisRun {
  id        String          @id @default(cuid())
  dataset   ScoutingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String

  /// Mappatura colonne usata: i risultati restano leggibili anche se la
  /// mappatura del dataset cambia dopo.
  mapping       Json
  promptVersion String
  model         String

  totalRows    Int @default(0)
  analyzedRows Int @default(0)
  failedRows   Int @default(0)

  /// Consumo complessivo della sessione, per rispondere a «quanto è costata».
  apiCalls     Int   @default(0)
  cachedRows   Int   @default(0)
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  costUsd      Float @default(0)

  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?

  rows AnalysisRunRow[]
  jobs ImportJob[]

  @@index([datasetId])
}

/// Una riga dentro una sessione di analisi: analisi, correzioni manuali e
/// stato rispetto al database.
model AnalysisRunRow {
  id    String      @id @default(cuid())
  run   AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  datasetRow   ScoutingDatasetRow @relation(fields: [datasetRowId], references: [id], onDelete: Cascade)
  datasetRowId String

  /// Analisi di provenienza. `SetNull` e non `Cascade`: cancellare una cache
  /// non deve cancellare la revisione fatta da un umano.
  analysis   RequestAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  analysisId String?

  rowNumber Int
  state     AnalysisRowState @default(NEEDS_REVIEW)

  /// Analisi **effettiva** della riga: parte da quella di Claude e incorpora
  /// le correzioni manuali. È questa che alimenta ricerca e identità.
  effectiveAnalysis Json?
  /// Solo i campi cambiati a mano, per poter mostrare cosa ha corretto l'utente.
  manualEdits       Json?
  edited            Boolean @default(false)
  /// `true` se l'analisi è arrivata dalla cache senza spendere una chiamata.
  fromCache         Boolean @default(false)
  /// Riga sbloccata a mano nonostante confidenza bassa o warning critici.
  approvedByUser    Boolean @default(false)

  familyKey    String?
  variantKey   String?
  duplicateKey String?
  confidence   Float?

  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobRows ImportJobRow[]

  @@unique([runId, datasetRowId])
  @@index([runId, state])
  @@index([variantKey])
}

/// L'elaborazione di un file: una per avvio, con la propria configurazione.
model ImportJob {
  id        String          @id @default(cuid())
  dataset   ScoutingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String

  /// Sessione di analisi da cui nasce il job. Nullable: i job avviati senza
  /// analisi IA — compresi tutti quelli già salvati — continuano a funzionare.
  analysisRun   AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  analysisRunId String?

  status  ImportJobStatus @default(QUEUED)
  engines String[]
  quality String          @default("balanced")

  candidatesPerEngine Int     @default(10)
  finalists           Int     @default(3)
  forceFullSearch     Boolean @default(false)
  aiRationale         Boolean @default(false)
  /// Mappatura usata da questo job: i risultati restano leggibili anche se
  /// la mappatura del dataset viene cambiata in seguito.
  mapping             Json

  totalRows     Int @default(0)
  processedRows Int @default(0)
  reusedRows    Int @default(0)
  failedRows    Int @default(0)

  /// Crediti Piloterr consumati da questo job (0 se la chiave non è attiva).
  creditsSpent Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  rows ImportJobRow[]

  @@index([datasetId])
  @@index([status])
}

/// Avanzamento e risultato di una singola riga dentro un job.
model ImportJobRow {
  id    String    @id @default(cuid())
  job   ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  datasetRow   ScoutingDatasetRow @relation(fields: [datasetRowId], references: [id], onDelete: Cascade)
  datasetRowId String

  request   ScoutingRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestId String?

  /// Riga di analisi che ha generato questa riga di job, quando il job nasce
  /// dalla revisione IA.
  analysisRow   AnalysisRunRow? @relation(fields: [analysisRowId], references: [id], onDelete: SetNull)
  analysisRowId String?

  rowNumber   Int
  displayName String
  searchQuery String
  status      ScoutingRowStatus @default(PENDING)
  /// true quando i prodotti arrivano da una richiesta già elaborata.
  reused      Boolean           @default(false)
  /// Perché la riga è stata riusata o rifatta: è la spiegazione mostrata
  /// all'utente quando chiede «perché non l'hai ricercato?».
  reuseReason String?
  error       String?

  startedAt  DateTime?
  finishedAt DateTime?

  engines ImportJobRowEngine[]
  results ScoutingResult[]

  @@unique([jobId, datasetRowId])
  @@index([jobId, status])
  @@index([requestId])
}

/// Esito della riga su un singolo marketplace: stato, conteggi ed errore
/// restano separati per fonte, così un captcha su Alibaba non nasconde i
/// risultati validi di Yiwugo e si può ritentare solo la fonte fallita.
model ImportJobRowEngine {
  id       String       @id @default(cuid())
  jobRow   ImportJobRow @relation(fields: [jobRowId], references: [id], onDelete: Cascade)
  jobRowId String

  engine String
  status ScoutingEngineStatus @default(PENDING)

  /// Query realmente inviata alla fonte (può differire da quella richiesta).
  queryUsed      String?
  fetchedCount   Int     @default(0)
  acceptedCount  Int     @default(0)
  durationMs     Int     @default(0)
  /// Codice tipizzato dell'errore (SOURCE_UPSTREAM, SOURCE_BUSY, …).
  errorCode      String?
  error          String?
  retryable      Boolean @default(false)
  attempts       Int     @default(0)
  /// true se i risultati provengono dalla cache e non hanno speso crediti.
  servedFromCache Boolean @default(false)

  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([jobRowId, engine])
  @@index([jobRowId])
}

/// Prodotto trovato per una richiesta. Vive oltre il singolo job: è ciò che
/// permette di riaprire le pagine e aggiornare i dati invece di ricercare.
model ProductCandidateRecord {
  id        String          @id @default(cuid())
  request   ScoutingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String

  engine     String
  externalId String
  url        String?
  title      String
  imageUrl   String?

  /// Query che ha fatto emergere questo candidato: serve a capire perché è
  /// stato trovato e a rieseguire la stessa ricerca in fase di aggiornamento.
  foundQuery String

  vendorName String?
  vendorUrl  String?

  price       Decimal? @db.Decimal(14, 4)
  currency    String?
  moq         Int?
  stock       Int?
  rating      Float?
  reviewCount Int?
  totalSales  Int?

  variants   Json?
  specs      Json?
  priceTiers Json?

  /// Punteggio di pertinenza calcolato dal motore già esistente.
  relevanceScore Float?
  matchReasons   String[]
  matchWarnings  String[]

  /// Impronta dei dati commerciali: se non cambia, il punteggio non si ricalcola.
  contentHash   String
  firstSeenAt   DateTime  @default(now())
  lastCheckedAt DateTime  @default(now())
  lastChangedAt DateTime?
  /// Campi cambiati all'ultimo aggiornamento.
  changedFields String[]
  /// Dettaglio prodotto già scaricato almeno una volta (M6).
  detailsFetchedAt DateTime?
  /// Prodotto non più raggiungibile all'ultimo controllo.
  unavailable   Boolean   @default(false)

  snapshots ProductSnapshot[]
  results   ScoutingResult[]

  @@unique([requestId, engine, externalId])
  @@index([requestId])
  @@index([requestId, engine])
}

/// Storico: una riga per ogni cambiamento reale dei dati del prodotto.
model ProductSnapshot {
  id          String                 @id @default(cuid())
  candidate   ProductCandidateRecord @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  capturedAt DateTime @default(now())

  price       Decimal? @db.Decimal(14, 4)
  currency    String?
  moq         Int?
  stock       Int?
  rating      Float?
  reviewCount Int?
  available   Boolean  @default(true)

  contentHash   String
  changedFields String[]

  @@index([candidateId, capturedAt])
}

/// Esito di un prodotto per una riga: finalista o scartato, con motivazione.
model ScoutingResult {
  id       String       @id @default(cuid())
  jobRow   ImportJobRow @relation(fields: [jobRowId], references: [id], onDelete: Cascade)
  jobRowId String

  candidate   ProductCandidateRecord @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  outcome ScoutingOutcome
  rank    Int?
  score   Float?
  /// Contributo di ogni criterio al punteggio finale.
  scoreBreakdown Json?

  rejectionCode   String?
  rejectionReason String?
  aiRationale     String?
  /// true se il punteggio è stato riusato perché i dati non sono cambiati.
  scoreReused     Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([jobRowId, candidateId])
  @@index([jobRowId])
}

/// Sessione di un marketplace che richiede login (1688, Taobao).
///
/// I cookie sono credenziali: stanno qui **solo cifrati** (AES-256-GCM) e non
/// vengono mai restituiti da un'API né scritti nei log. Di ogni sessione si
/// espone soltanto lo stato: quale account, quando scade, quando è stata usata.
model MarketplaceSession {
  id          String @id @default(cuid())
  marketplace String @unique

  /// Etichetta scelta dall'utente per riconoscere l'account.
  label String?

  /// Blob cifrato dei cookie, con il proprio vettore e tag di autenticazione.
  ciphertext String
  iv         String
  authTag    String
  /// Impronta del contenuto: dice se la sessione è cambiata senza esporla.
  digest     String

  /// Nomi dei cookie presenti, senza valori: utile per diagnosticare.
  cookieNames String[]
  /// Scadenza dichiarata dai cookie stessi, quando presente.
  expiresAt   DateTime?

  lastUsedAt   DateTime?
  lastFailedAt DateTime?
  /// Motivo dell'ultimo fallimento: serve a capire se va ricollegata.
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// ---------------------------------------------------------------------------
/// Scouting v1: solo Taobao, per cliente.
///
/// Blocco **additivo**: nessun modello preesistente cambia comportamento. Lo
/// scouting multi-marketplace (ScoutingDataset/ImportJob/...) resta intatto e
/// continua a servire la pagina `/scouting`.
///
/// Due livelli, e la distinzione è il cuore della privacy fra clienti:
///
/// - **visibile al cliente** — `Client`, `TaobaoDataset`, `TaobaoAnalysisRun`,
///   `TaobaoJob` e le loro righe. Ogni lettura passa da `clientId`.
/// - **memoria interna condivisa** — `TaobaoRequest` (la variante) e
///   `TaobaoProduct` (il prodotto trovato). Servono a non ricercare due volte
///   lo stesso prodotto, e non sono mai esposti se non attraverso le righe di
///   job del cliente che li ha richiesti.
/// ---------------------------------------------------------------------------

/// Il cliente per cui si fa sourcing: tutto il lavoro gli appartiene.
model Client {
  id   String @id @default(cuid())
  name String
  /// Identificativo leggibile e stabile, usato negli URL e nell'export.
  slug String @unique

  contact  String?
  notes    String?
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  datasets     TaobaoDataset[]
  analysisRuns TaobaoAnalysisRun[]
  jobs         TaobaoJob[]
  pipelines    TaobaoPipeline[]
}

/// Un file caricato per un cliente.
model TaobaoDataset {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  fileName  String
  format    String
  sheetName String
  sizeBytes Int

  headerRowNumber Int?
  columns         Json
  mapping         Json?
  rowCount        Int
  warnings        String[]

  createdAt DateTime @default(now())

  rows         TaobaoDatasetRow[]
  analysisRuns TaobaoAnalysisRun[]
  jobs         TaobaoJob[]

  @@index([clientId, createdAt])
  pipelines    TaobaoPipeline[]
}

/// Riga originale del file: le celle restano intatte.
model TaobaoDatasetRow {
  id        String        @id @default(cuid())
  dataset   TaobaoDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String

  rowNumber      Int
  sheetName      String @default("")
  sheetRowNumber Int    @default(0)
  cells          Json
  /// Link prodotto già presente nel foglio: è una fonte di candidati.
  hyperlink      String?

  analysisRows TaobaoAnalysisRow[]
  jobRows      TaobaoJobRow[]

  @@unique([datasetId, rowNumber])
  @@index([datasetId])
}

/// Sessione di analisi IA su un file, rivista da un umano prima della ricerca.
model TaobaoAnalysisRun {
  id        String        @id @default(cuid())
  dataset   TaobaoDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String

  mapping       Json
  promptVersion String
  model         String

  totalRows    Int @default(0)
  analyzedRows Int @default(0)
  failedRows   Int @default(0)

  apiCalls     Int   @default(0)
  cachedRows   Int   @default(0)
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  costUsd      Float @default(0)

  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?

  rows TaobaoAnalysisRow[]
  jobs TaobaoJob[]

  @@index([datasetId])
  @@index([clientId])
  pipelines TaobaoPipeline[]
}

/// Una riga analizzata: interpretazione, correzioni manuali e stato.
model TaobaoAnalysisRow {
  id    String            @id @default(cuid())
  run   TaobaoAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  datasetRow   TaobaoDatasetRow @relation(fields: [datasetRowId], references: [id], onDelete: Cascade)
  datasetRowId String

  /// Analisi di provenienza nella cache condivisa. `SetNull`: svuotare la
  /// cache non deve cancellare la revisione fatta da un umano.
  analysis   RequestAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  analysisId String?

  rowNumber Int
  state     AnalysisRowState @default(NEEDS_REVIEW)

  /// Testo che descrive la merce (nome, specifiche, utilizzo, titolo), senza
  /// quantità né link. È la sorgente della firma residua che tiene separate
  /// le varianti quando l'analisi non estrae una misura: va conservato perché
  /// una correzione manuale deve poter ricalcolare le stesse chiavi.
  signatureText String?

  effectiveAnalysis Json?
  manualEdits       Json?
  edited            Boolean @default(false)
  fromCache         Boolean @default(false)
  approvedByUser    Boolean @default(false)

  familyKey    String?
  variantKey   String?
  duplicateKey String?
  confidence   Float?

  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobRows TaobaoJobRow[]

  @@unique([runId, datasetRowId])
  @@index([runId, state])
  @@index([variantKey])
}

/// ---------------------------------------------------------------------------
/// Memoria interna: variante richiesta e prodotti trovati su Taobao.
/// Condivisa fra clienti per non ripetere ricerche già pagate.
/// ---------------------------------------------------------------------------

/// Una variante di prodotto cercata su Taobao.
model TaobaoRequest {
  id String @id @default(cuid())

  /// Identità che decide il riuso.
  variantKey   String  @unique
  familyKey    String
  duplicateKey String?

  displayName        String
  productNameChinese String?
  productNameEnglish String?
  model              String?
  material           String?
  color              String?

  /// Query cinese: è quella che si usa davvero su Taobao.
  searchQueryChinese String?
  searchQueryEnglish String?

  /// Analisi effettiva che ha generato la variante: serve a rivalutare i
  /// prodotti (requisiti, misure) senza ricostruirla dalla riga.
  analysis Json?

  hardRequirements String[]
  softRequirements String[]

  firstSeenAt    DateTime  @default(now())
  lastSearchedAt DateTime?
  lastVerifiedAt DateTime?
  searchCount    Int       @default(0)

  products TaobaoProduct[]
  jobRows  TaobaoJobRow[]

  @@index([familyKey])
}

/// Un prodotto trovato per una variante.
model TaobaoProduct {
  id        String        @id @default(cuid())
  request   TaobaoRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String

  /// Marketplace di provenienza: `taobao` oppure `1688`.
  ///
  /// Entra nella chiave di unicità perché gli identificativi sono numerici su
  /// entrambi e nulla garantisce che non collidano: senza, un'offerta 1688 e
  /// un prodotto Taobao con lo stesso numero si sovrascriverebbero a vicenda.
  platform String @default("taobao")

  /// Identità del prodotto sul suo marketplace.
  itemId String
  url    String?
  title  String
  /// Titolo tradotto, quando la fonte lo espone (ElimAPI con `lang=en`).
  titleEn String?

  imageUrl String?

  price         Decimal? @db.Decimal(14, 4)
  currency      String?
  /// Prezzo della variante specifica, quando la scheda lo espone separato.
  variantPrice  Decimal? @db.Decimal(14, 4)
  /// Prezzo promozionale: è quello che si paga oggi, se c'è una promozione.
  promotionPrice Decimal? @db.Decimal(14, 4)
  /// Quantità minima d'ordine (1688 la usa quasi sempre).
  moq           Int?
  /// SKU/variante identificata dalla fonte, quando ne espone una.
  sku           String?

  shopName String?
  shopUrl  String?
  sellerId String?

  totalSales  Int?
  reviewCount Int?
  rating      Float?

  specs        Json?
  variants     Json?
  availability String?
  /// Spedizione interna in Cina, quando la fonte la espone.
  shipping     Json?

  /// Query che l'ha fatto emergere.
  foundQuery String
  /// Provenienze che hanno visto questo prodotto: api, playwright, excel, memory.
  sources    String[]

  contentHash   String
  firstSeenAt   DateTime  @default(now())
  lastCheckedAt DateTime  @default(now())
  lastChangedAt DateTime?
  changedFields String[]
  unavailable   Boolean   @default(false)

  detailFetchedAt DateTime?
  reviewFetchedAt DateTime?

  /// Risposta grezza della fonte, così com'è arrivata.
  ///
  /// Le fonti espongono campi che oggi non normalizziamo (fasce di prezzo,
  /// promozioni, tassi di riacquisto): conservarli costa poco e evita di
  /// dover rifare — e ripagare — la chiamata quando servono.
  raw Json?

  snapshots TaobaoPriceSnapshot[]
  results   TaobaoJobResult[]

  @@unique([requestId, platform, itemId])
  @@index([requestId])
  @@index([requestId, platform])
}

/// Storico: una riga per ogni cambiamento reale del prodotto.
model TaobaoPriceSnapshot {
  id        String        @id @default(cuid())
  product   TaobaoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  capturedAt DateTime @default(now())

  price       Decimal? @db.Decimal(14, 4)
  currency    String?
  totalSales  Int?
  reviewCount Int?
  available   Boolean  @default(true)

  contentHash   String
  changedFields String[]

  @@index([productId, capturedAt])
}

/// ---------------------------------------------------------------------------
/// Esecuzione della ricerca.
/// ---------------------------------------------------------------------------

enum TaobaoJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum TaobaoRowStatus {
  PENDING
  REFRESHING
  SEARCHING_API
  SEARCHING_BROWSER
  DONE
  SKIPPED
  FAILED
}

/// L'elaborazione di un file per un cliente.
model TaobaoJob {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  dataset   TaobaoDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String

  analysisRun   TaobaoAnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  analysisRunId String?

  status  TaobaoJobStatus @default(QUEUED)
  mapping Json

  /// Ricerca completa anche per le varianti già conosciute.
  forceFullSearch Boolean @default(false)
  /// Usa anche Playwright se l'account Taobao è collegato.
  useBrowser      Boolean @default(true)
  maxCandidates   Int     @default(10)
  /// Dettaglio prodotto (1 chiamata) sui primi N candidati di ogni riga.
  detailTopN      Int     @default(3)
  /// Usa ElimAPI come riserva quando DataHub non basta.
  useElim         Boolean @default(true)
  /// Cerca anche su 1688 tramite ElimAPI (facoltativo).
  use1688         Boolean @default(false)
  /// Recensioni (1 chiamata) sui primi N finalisti di ogni riga.
  reviewTopN      Int     @default(0)

  totalRows     Int @default(0)
  processedRows Int @default(0)
  reusedRows    Int @default(0)
  searchedRows  Int @default(0)
  failedRows    Int @default(0)

  /// Consumo RapidAPI di questo job, per endpoint e in totale.
  apiCalls      Int  @default(0)
  apiCacheHits  Int  @default(0)
  /// Chiamate «Taobao API by H-W-H»: piano RapidAPI separato da DataHub.
  hwhCalls      Int  @default(0)
  browserCalls  Int  @default(0)
  /// Richieste ElimAPI consumate: il piano le conta a parte da DataHub.
  elimCalls     Int  @default(0)
  /// Prodotti riusati dalla memoria e prodotti trovati da zero.
  reusedProducts Int @default(0)
  newProducts    Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  rows TaobaoJobRow[]

  @@index([clientId, createdAt])
  @@index([datasetId])
  @@index([status])
  pipelines TaobaoPipeline[]
}

/// Avanzamento e risultato di una riga.
model TaobaoJobRow {
  id    String    @id @default(cuid())
  job   TaobaoJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  datasetRow   TaobaoDatasetRow @relation(fields: [datasetRowId], references: [id], onDelete: Cascade)
  datasetRowId String

  analysisRow   TaobaoAnalysisRow? @relation(fields: [analysisRowId], references: [id], onDelete: SetNull)
  analysisRowId String?

  request   TaobaoRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestId String?

  rowNumber   Int
  displayName String
  searchQuery String
  status      TaobaoRowStatus @default(PENDING)

  /// true quando i prodotti arrivano dalla memoria invece che da una ricerca.
  reused      Boolean @default(false)
  /// Perché è stata riusata o rifatta: è la risposta a «perché non l'hai cercato?».
  reuseReason String?
  /// Le query realmente inviate alla fonte, in ordine di tentativo.
  /// Su una riga senza risultato è l'unica spiegazione utile: dice se il
  /// problema è la traduzione, i vincoli o il catalogo.
  attemptedQueries String[]

  /// Esito separato per trasporto: un captcha su Playwright non deve
  /// cancellare i risultati dell'API.
  /// H-W-H è la ricerca primaria; DataHub interviene come fallback.
  hwhStatus     String?
  hwhError      String?
  hwhCount      Int     @default(0)
  apiStatus     String?
  apiError      String?
  apiCount      Int     @default(0)
  /// Esito della seconda fonte (ElimAPI), separato da quello della prima.
  elimStatus    String?
  elimError     String?
  elimCount     Int     @default(0)
  browserStatus String?
  browserError  String?
  browserCount  Int     @default(0)

  error String?

  startedAt  DateTime?
  finishedAt DateTime?

  results TaobaoJobResult[]

  @@unique([jobId, datasetRowId])
  @@index([jobId, status])
  @@index([requestId])
}

/// Un prodotto proposto per una riga, con il perché del suo posto in classifica.
model TaobaoJobResult {
  id       String       @id @default(cuid())
  jobRow   TaobaoJobRow @relation(fields: [jobRowId], references: [id], onDelete: Cascade)
  jobRowId String

  product   TaobaoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  rank  Int
  score Float @default(0)
  /// Contributo di ogni criterio: compatibilità, prezzo, vendite, recensioni.
  scoreBreakdown Json?

  matchedRequirements String[]
  missingRequirements String[]
  warnings            String[]
  /// Provenienze che hanno contribuito a questo candidato.
  sources             String[]
  /// Differenze rilevate fra le fonti (prezzo o disponibilità discordanti).
  sourceConflicts     String[]

  /// Verdetto della seconda passata IA: il prodotto è coerente con la riga
  /// del foglio? `{ verdict, issues, confidence, model }`. `null` finché la
  /// verifica non è stata chiesta: l'assenza è un dato, non un errore.
  coherence          Json?
  coherenceCheckedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([jobRowId, productId])
  @@index([jobRowId])
}

/// ---------------------------------------------------------------------------
/// Domande di chiarimento e conoscenza accumulata.
/// ---------------------------------------------------------------------------

/// Un dubbio che l'IA non ha saputo sciogliere da sola, diventato domanda.
///
/// La risposta dell'operatore non serve solo alla riga che l'ha generata:
/// viene iniettata come conoscenza nelle analisi successive, così la stessa
/// domanda non viene rifatta. La chiave `questionKey` è ciò che tiene il
/// numero di domande al minimo: dieci righe con la stessa ambiguità sono
/// UNA domanda, e una domanda già risposta non viene più posta.
model TaobaoClarification {
  id String @id @default(cuid())

  /// Identità del dubbio: codice + famiglia + soggetto normalizzati.
  questionKey String @unique

  /// Da dove nasce: `analysis` (lettura del foglio) o `verify` (coerenza).
  source String @default("analysis")
  /// Codice del warning che l'ha originata, se c'è.
  code      String?
  familyKey String?

  question String
  answer   String?
  /// OPEN → ANSWERED (risposta data) oppure DISMISSED (non serve rispondere).
  status String @default("OPEN")

  /// Esempi di testo che hanno sollevato il dubbio (max qualche riga).
  examples String[]

  /// Risposte già pronte, quando il dubbio è una scelta e non un tema.
  ///
  /// Chiedere «quale unità?» con un campo di testo scarica sull'operatore un
  /// lavoro che il sistema può fare: proporre mm, cm o m e farne scegliere
  /// una. Vuoto quando la risposta è davvero libera.
  options String[]

  /// Come si risponde: `single` (una opzione), `multi` (più), `text` (libero).
  answerMode String @default("text")
  /// Quante righe hanno incontrato questo dubbio: dà priorità alle domande.
  hitCount Int @default(1)
  /// Quante analisi hanno riusato la risposta come conoscenza.
  timesApplied Int @default(0)

  createdAt  DateTime  @default(now())
  answeredAt DateTime?
  updatedAt  DateTime  @updatedAt

  /// Scope opzionale usato esclusivamente dalla v2. Le righe storiche e la
  /// v1 restano globali come prima; una domanda v2 appartiene sempre a una
  /// singola pipeline e al relativo cliente/file/analisi.
  clientId      String?
  pipelineId    String?
  datasetId     String?
  analysisRunId String?
  locale        String?
  category      String?
  attributeKey  String?
  priority      Int     @default(0)

  pipeline TaobaoPipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([familyKey])
  @@index([clientId, pipelineId, status])
  @@index([pipelineId, questionKey])
}

/// Cache delle chiamate RapidAPI: i crediti si pagano una volta sola.
model TaobaoApiCache {
  id       String @id @default(cuid())
  /// Hash di endpoint + parametri normalizzati.
  cacheKey String @unique

  endpoint String
  payload  Json
  /// Crediti spesi dalla chiamata che ha riempito questa voce.
  credits  Int    @default(1)

  fetchedAt DateTime @default(now())

  @@index([endpoint, fetchedAt])
}

/* -------------------------------------------------------------------------- */
/* Scouting v2: l'elaborazione che si guida da sola                            */
/* -------------------------------------------------------------------------- */

enum TaobaoPipelineStatus {
  RUNNING
  /// In pausa: l'IA ha domande e senza risposta proseguirebbe alla cieca.
  WAITING_ANSWERS
  COMPLETED
  FAILED
  CANCELLED
}

enum TaobaoPipelinePhase {
  QUEUED
  ANALYSIS
  QUESTIONS
  REVIEW
  SEARCH
  VERIFY
  REFINE
  REPORT
}

/// Un'elaborazione completa: dal foglio caricato alla quotazione.
///
/// Esiste perché lo stato di una corsa che dura minuti non può vivere nella
/// pagina: chi chiude la scheda a metà ricerca deve ritrovare il lavoro (e i
/// crediti) al rientro, non ricominciare. Il servizio riprende da `phase`.
///
/// Non duplica i dati delle fasi: analisi, job e risultati restano nelle loro
/// tabelle e qui se ne tiene solo il riferimento. Questa riga risponde a una
/// domanda sola — «a che punto siamo, e cosa succede dopo».
model TaobaoPipeline {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  dataset   TaobaoDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String

  status TaobaoPipelineStatus @default(RUNNING)
  phase  TaobaoPipelinePhase  @default(QUEUED)

  /// Quale delle due pagine ha avviato la corsa: `v2` o `v3`.
  ///
  /// La v3 non è un secondo backend: è la stessa pipeline con due regole
  /// diverse — i prodotti con un link nel foglio si risolvono aprendo il link
  /// invece di cercarli, e per gli altri si guardano più candidati scegliendo
  /// il più economico fra quelli che corrispondono davvero. Tenere il segno
  /// sulla corsa (e non su un interruttore globale) è ciò che permette alle
  /// due di convivere: una corsa v2 avviata ieri resta una corsa v2 anche se
  /// la si riapre domani.
  mode String @default("v2")

  /// 0-100. Monotono: non torna indietro nemmeno fra un giro di ri-ricerca e l'altro.
  progress Int @default(0)
  /// Chiave del dizionario che descrive il passo in corso (mai una frase).
  step     String @default("step.queued")
  /// Valori da inserire nella frase di `step`.
  stepParams Json?

  mapping    Json
  markupPct  Float @default(15)
  /// Quante volte insistere sulle righe senza un prodotto coerente.
  maxRefineRounds Int     @default(2)
  forceFullSearch Boolean @default(false)
  /// Lingua esplicita della corsa: le domande non dipendono dal contesto
  /// della richiesta HTTP che ha avviato il lavoro in background.
  locale String @default("it")

  analysisRun   TaobaoAnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  analysisRunId String?
  job           TaobaoJob?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId         String?

  /// Giri di ri-ricerca già fatti e quante volte l'IA ha già chiesto.
  refineRounds  Int @default(0)
  questionRound Int @default(0)
  /// Righe recuperate dalle ri-ricerche: entra nel riepilogo finale.
  recoveredRows Int @default(0)

  /// Fasi concluse, in ordine: la pagina le spunta senza doverlo dedurre.
  completedPhases TaobaoPipelinePhase[]

  /// Riepilogo finale, nella forma di `TaobaoPipelineOutcome`.
  outcome Json?

  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  clarifications TaobaoClarification[]

  @@index([clientId, createdAt])
  @@index([datasetId])
  @@index([status])
}
