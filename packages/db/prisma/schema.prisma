generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  RECEIVED // creata, in coda per il parsing
  PARSING // Claude sta estraendo la lista strutturata
  SEARCHING // fan-out ricerche sui marketplace
  ASSEMBLING // fan-in: calcolo preventivo
  READY // preventivo pronto
  FAILED
}

enum ItemStatus {
  PENDING
  SEARCHING
  MATCHING // selezione AI dei candidati migliori
  SELECTED
  NO_RESULTS // nessun candidato trovato/adeguato: da quotare a mano
  FAILED
}

model QuoteRequest {
  id        String        @id @default(cuid())
  rawText   String
  status    RequestStatus @default(RECEIVED)
  markupPct Float
  currency  String        @default("USD")
  error     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items RequestItem[]
  quote Quote?
}

model RequestItem {
  id        String       @id @default(cuid())
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  position  Int

  name       String
  quantity   Int
  color      String?
  size       String?
  attributes Json?
  notes      String?

  queryEn String?
  queryZh String?

  status ItemStatus @default(PENDING)
  error  String?

  candidates ProductCandidate[]

  @@index([requestId])
}

model ProductCandidate {
  id     String      @id @default(cuid())
  item   RequestItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  marketplace String
  externalId  String // id opaco lato adapter (per gli scraper: l'URL prodotto)
  title       String
  url         String
  imageUrl    String?

  priceValue    Decimal? @db.Decimal(12, 4)
  priceCurrency String?
  moq           Int?
  raw           Json?

  // Valorizzati dal passo di matching AI (solo per i candidati scelti)
  selectedRank Int? // 1 = scelta principale, 2-3 alternative
  score        Float?
  reason       String?
  variant      String?

  createdAt DateTime @default(now())

  @@unique([itemId, marketplace, externalId])
  @@index([itemId])
}

model Quote {
  id        String       @id @default(cuid())
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String       @unique

  currency   String
  markupPct  Float
  totalCost  Decimal @db.Decimal(14, 2)
  totalPrice Decimal @db.Decimal(14, 2)

  createdAt DateTime    @default(now())
  lines     QuoteLine[]
}

model QuoteLine {
  id      String @id @default(cuid())
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String

  itemId      String
  candidateId String?

  description String
  quantity    Int
  unitCost    Decimal @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(12, 4)
  lineTotal   Decimal @db.Decimal(14, 2)

  marketplace String?
  url         String?
  imageUrl    String?
  moq         Int?
  variant     String?
  note        String?

  @@index([quoteId])
}

/// ---------------------------------------------------------------------------
/// Scouting prodotti multi-marketplace da file (Excel/XLS/CSV).
///
/// Blocco additivo: nessun modello preesistente viene modificato. La pipeline
/// preventivi (QuoteRequest/RequestItem/ProductCandidate) resta intatta.
///
/// Gerarchia: un file caricato (ScoutingDataset) genera un ImportJob; ogni
/// riga del job punta alla ScoutingRequest identificata dalla sua impronta,
/// quindi righe duplicate — nello stesso file o in file diversi — condividono
/// la stessa richiesta e gli stessi candidati.
/// ---------------------------------------------------------------------------

enum ImportJobStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ScoutingRowStatus {
  PENDING
  SEARCHING
  REFRESHING
  SCORING
  DONE
  SKIPPED
  FAILED
  CANCELLED
}

enum ScoutingEngineStatus {
  PENDING
  RUNNING
  DONE
  ERROR
  SKIPPED
}

enum ScoutingOutcome {
  FINALIST
  SHORTLISTED
  REJECTED
}

/// Un file caricato dall'utente, con le colonne riconosciute.
model ScoutingDataset {
  id        String   @id @default(cuid())
  fileName  String
  format    String // xlsx | xls | xlsm | csv
  sheetName String
  sizeBytes Int

  /// Riga di intestazione nel file (1-based); null se il file non ne ha.
  headerRowNumber Int?
  /// Colonne riconosciute (DatasetColumn[]), con campioni e suggerimenti.
  columns         Json
  /// Ultima mappatura colonna→campo confermata dall'utente.
  mapping         Json?
  rowCount        Int
  warnings        String[]

  createdAt DateTime @default(now())

  rows         ScoutingDatasetRow[]
  jobs         ImportJob[]
  analysisRuns AnalysisRun[]
}

/// Riga originale del file: i valori delle celle restano intatti.
model ScoutingDatasetRow {
  id        String          @id @default(cuid())
  dataset   ScoutingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String

  /// Numero di riga nel file di origine (1-based).
  rowNumber Int
  /// Valori originali, allineati a ScoutingDataset.columns.
  cells     Json
  hyperlink String?

  jobRows      ImportJobRow[]
  analysisRows AnalysisRunRow[]

  @@unique([datasetId, rowNumber])
  @@index([datasetId])
}

/// Richiesta normalizzata: identità stabile fra file, righe e formulazioni.
model ScoutingRequest {
  id String @id @default(cuid())

  /// Impronta stabile (SHA-256 troncato): identità forte della richiesta.
  ///
  /// Resta la chiave del percorso senza analisi IA (import diretto, job già
  /// salvati). Con l'analisi attiva l'identità è `variantKey`: l'impronta
  /// continua a essere calcolata e salvata, ma non decide più il riuso.
  fingerprint       String  @unique
  /// Identità debole, per proporre richieste simili già elaborate.
  normalizedNameKey String
  displayName       String
  normalizedName    String

  /// ------------------------------------------------------------------
  /// Identità a tre livelli (dall'analisi Claude).
  ///
  /// Nullable perché le richieste create prima dell'analisi IA non le hanno:
  /// il riuso ricade sull'impronta, come prima. `variantKey` è unica quando
  /// presente — in Postgres più `NULL` non collidono fra loro.
  /// ------------------------------------------------------------------
  familyKey    String?
  variantKey   String? @unique
  duplicateKey String?

  productNameChinese String?
  productNameEnglish String?
  searchQueryChinese String?
  searchQueryEnglish String?

  /// Ultima volta che i prodotti di questa variante sono stati riletti alla
  /// fonte. Diverso da `lastSearchedAt`: quella è l'ultima **ricerca**, questa
  /// l'ultima **verifica** di ciò che avevamo già.
  lastVerifiedAt DateTime?

  category String?
  brand    String?
  model    String?
  material String?
  power    Float?
  voltage  Float?
  capacity Float?

  dimensions      Json
  requiredVariant Json
  certifications  String[]
  requirements    Json

  requestedQuantity Float?
  unit              String?
  targetPrice       Float?
  notes             String?
  referenceUrl      String?

  searchQuery String
  language    String

  firstSeenAt    DateTime  @default(now())
  lastSearchedAt DateTime?
  searchCount    Int       @default(0)

  candidates ProductCandidateRecord[]
  jobRows    ImportJobRow[]

  @@index([normalizedNameKey])
  @@index([familyKey])
  @@index([duplicateKey])
}

/// ---------------------------------------------------------------------------
/// Analisi delle richieste con Claude.
///
/// La memoria del sistema vive qui, non nella conversazione: ogni analisi è un
/// record con la versione del prompt e il modello che l'hanno prodotta. Prima
/// di richiamare l'API si cerca in `RequestAnalysis` la stessa riga
/// normalizzata analizzata con la stessa versione del prompt; se c'è, la
/// chiamata non si fa.
/// ---------------------------------------------------------------------------

enum AnalysisRowState {
  NEW_PRODUCT
  NEW_VARIANT
  KNOWN_PRODUCT
  NEEDS_REVIEW
  ANALYSIS_FAILED
  READY
}

/// Analisi di una riga, riusabile fra file e sessioni diverse.
///
/// La chiave è (testo normalizzato, versione prompt, modello): cambiare il
/// prompt o il modello produce una nuova analisi invece di sporcare quella
/// vecchia, così si può confrontare il prima e il dopo.
model RequestAnalysis {
  id String @id @default(cuid())

  /// SHA-256 del testo inviato: la riga stessa non viene usata come chiave
  /// perché può essere lunga e contenere caratteri di ogni scrittura.
  inputHash     String
  promptVersion String
  model         String

  /// Testo effettivamente inviato a Claude, conservato per poter rispiegare
  /// **su cosa** è stata fatta l'analisi (e per riprodurla).
  submittedText String

  /// Risultato validato con Zod (`ProductAnalysis`); `null` se l'analisi è
  /// fallita — anche i fallimenti si memorizzano, per non ritentare in loop.
  analysis Json?
  ok       Boolean @default(true)
  error    String?

  familyKey    String?
  variantKey   String?
  duplicateKey String?
  confidence   Float?

  /// Consumo della chiamata che ha prodotto questa analisi. Con un batch, i
  /// token sono già ripartiti fra le righe che ne facevano parte.
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  costUsd      Float @default(0)

  createdAt DateTime @default(now())

  rows AnalysisRunRow[]

  @@unique([inputHash, promptVersion, model])
  @@index([variantKey])
}

/// Una sessione di analisi su un file: è ciò che l'utente rivede prima di
/// avviare lo scouting.
model AnalysisRun {
  id        String          @id @default(cuid())
  dataset   ScoutingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String

  /// Mappatura colonne usata: i risultati restano leggibili anche se la
  /// mappatura del dataset cambia dopo.
  mapping       Json
  promptVersion String
  model         String

  totalRows    Int @default(0)
  analyzedRows Int @default(0)
  failedRows   Int @default(0)

  /// Consumo complessivo della sessione, per rispondere a «quanto è costata».
  apiCalls     Int   @default(0)
  cachedRows   Int   @default(0)
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  costUsd      Float @default(0)

  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?

  rows AnalysisRunRow[]
  jobs ImportJob[]

  @@index([datasetId])
}

/// Una riga dentro una sessione di analisi: analisi, correzioni manuali e
/// stato rispetto al database.
model AnalysisRunRow {
  id    String      @id @default(cuid())
  run   AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  datasetRow   ScoutingDatasetRow @relation(fields: [datasetRowId], references: [id], onDelete: Cascade)
  datasetRowId String

  /// Analisi di provenienza. `SetNull` e non `Cascade`: cancellare una cache
  /// non deve cancellare la revisione fatta da un umano.
  analysis   RequestAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  analysisId String?

  rowNumber Int
  state     AnalysisRowState @default(NEEDS_REVIEW)

  /// Analisi **effettiva** della riga: parte da quella di Claude e incorpora
  /// le correzioni manuali. È questa che alimenta ricerca e identità.
  effectiveAnalysis Json?
  /// Solo i campi cambiati a mano, per poter mostrare cosa ha corretto l'utente.
  manualEdits       Json?
  edited            Boolean @default(false)
  /// `true` se l'analisi è arrivata dalla cache senza spendere una chiamata.
  fromCache         Boolean @default(false)
  /// Riga sbloccata a mano nonostante confidenza bassa o warning critici.
  approvedByUser    Boolean @default(false)

  familyKey    String?
  variantKey   String?
  duplicateKey String?
  confidence   Float?

  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobRows ImportJobRow[]

  @@unique([runId, datasetRowId])
  @@index([runId, state])
  @@index([variantKey])
}

/// L'elaborazione di un file: una per avvio, con la propria configurazione.
model ImportJob {
  id        String          @id @default(cuid())
  dataset   ScoutingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String

  /// Sessione di analisi da cui nasce il job. Nullable: i job avviati senza
  /// analisi IA — compresi tutti quelli già salvati — continuano a funzionare.
  analysisRun   AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  analysisRunId String?

  status  ImportJobStatus @default(QUEUED)
  engines String[]
  quality String          @default("balanced")

  candidatesPerEngine Int     @default(10)
  finalists           Int     @default(3)
  forceFullSearch     Boolean @default(false)
  aiRationale         Boolean @default(false)
  /// Mappatura usata da questo job: i risultati restano leggibili anche se
  /// la mappatura del dataset viene cambiata in seguito.
  mapping             Json

  totalRows     Int @default(0)
  processedRows Int @default(0)
  reusedRows    Int @default(0)
  failedRows    Int @default(0)

  /// Crediti Piloterr consumati da questo job (0 se la chiave non è attiva).
  creditsSpent Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  rows ImportJobRow[]

  @@index([datasetId])
  @@index([status])
}

/// Avanzamento e risultato di una singola riga dentro un job.
model ImportJobRow {
  id    String    @id @default(cuid())
  job   ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  datasetRow   ScoutingDatasetRow @relation(fields: [datasetRowId], references: [id], onDelete: Cascade)
  datasetRowId String

  request   ScoutingRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestId String?

  /// Riga di analisi che ha generato questa riga di job, quando il job nasce
  /// dalla revisione IA.
  analysisRow   AnalysisRunRow? @relation(fields: [analysisRowId], references: [id], onDelete: SetNull)
  analysisRowId String?

  rowNumber   Int
  displayName String
  searchQuery String
  status      ScoutingRowStatus @default(PENDING)
  /// true quando i prodotti arrivano da una richiesta già elaborata.
  reused      Boolean           @default(false)
  /// Perché la riga è stata riusata o rifatta: è la spiegazione mostrata
  /// all'utente quando chiede «perché non l'hai ricercato?».
  reuseReason String?
  error       String?

  startedAt  DateTime?
  finishedAt DateTime?

  engines ImportJobRowEngine[]
  results ScoutingResult[]

  @@unique([jobId, datasetRowId])
  @@index([jobId, status])
  @@index([requestId])
}

/// Esito della riga su un singolo marketplace: stato, conteggi ed errore
/// restano separati per fonte, così un captcha su Alibaba non nasconde i
/// risultati validi di Yiwugo e si può ritentare solo la fonte fallita.
model ImportJobRowEngine {
  id       String       @id @default(cuid())
  jobRow   ImportJobRow @relation(fields: [jobRowId], references: [id], onDelete: Cascade)
  jobRowId String

  engine String
  status ScoutingEngineStatus @default(PENDING)

  /// Query realmente inviata alla fonte (può differire da quella richiesta).
  queryUsed      String?
  fetchedCount   Int     @default(0)
  acceptedCount  Int     @default(0)
  durationMs     Int     @default(0)
  /// Codice tipizzato dell'errore (SOURCE_UPSTREAM, SOURCE_BUSY, …).
  errorCode      String?
  error          String?
  retryable      Boolean @default(false)
  attempts       Int     @default(0)
  /// true se i risultati provengono dalla cache e non hanno speso crediti.
  servedFromCache Boolean @default(false)

  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([jobRowId, engine])
  @@index([jobRowId])
}

/// Prodotto trovato per una richiesta. Vive oltre il singolo job: è ciò che
/// permette di riaprire le pagine e aggiornare i dati invece di ricercare.
model ProductCandidateRecord {
  id        String          @id @default(cuid())
  request   ScoutingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String

  engine     String
  externalId String
  url        String?
  title      String
  imageUrl   String?

  /// Query che ha fatto emergere questo candidato: serve a capire perché è
  /// stato trovato e a rieseguire la stessa ricerca in fase di aggiornamento.
  foundQuery String

  vendorName String?
  vendorUrl  String?

  price       Decimal? @db.Decimal(14, 4)
  currency    String?
  moq         Int?
  stock       Int?
  rating      Float?
  reviewCount Int?
  totalSales  Int?

  variants   Json?
  specs      Json?
  priceTiers Json?

  /// Punteggio di pertinenza calcolato dal motore già esistente.
  relevanceScore Float?
  matchReasons   String[]
  matchWarnings  String[]

  /// Impronta dei dati commerciali: se non cambia, il punteggio non si ricalcola.
  contentHash   String
  firstSeenAt   DateTime  @default(now())
  lastCheckedAt DateTime  @default(now())
  lastChangedAt DateTime?
  /// Campi cambiati all'ultimo aggiornamento.
  changedFields String[]
  /// Dettaglio prodotto già scaricato almeno una volta (M6).
  detailsFetchedAt DateTime?
  /// Prodotto non più raggiungibile all'ultimo controllo.
  unavailable   Boolean   @default(false)

  snapshots ProductSnapshot[]
  results   ScoutingResult[]

  @@unique([requestId, engine, externalId])
  @@index([requestId])
  @@index([requestId, engine])
}

/// Storico: una riga per ogni cambiamento reale dei dati del prodotto.
model ProductSnapshot {
  id          String                 @id @default(cuid())
  candidate   ProductCandidateRecord @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  capturedAt DateTime @default(now())

  price       Decimal? @db.Decimal(14, 4)
  currency    String?
  moq         Int?
  stock       Int?
  rating      Float?
  reviewCount Int?
  available   Boolean  @default(true)

  contentHash   String
  changedFields String[]

  @@index([candidateId, capturedAt])
}

/// Esito di un prodotto per una riga: finalista o scartato, con motivazione.
model ScoutingResult {
  id       String       @id @default(cuid())
  jobRow   ImportJobRow @relation(fields: [jobRowId], references: [id], onDelete: Cascade)
  jobRowId String

  candidate   ProductCandidateRecord @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  outcome ScoutingOutcome
  rank    Int?
  score   Float?
  /// Contributo di ogni criterio al punteggio finale.
  scoreBreakdown Json?

  rejectionCode   String?
  rejectionReason String?
  aiRationale     String?
  /// true se il punteggio è stato riusato perché i dati non sono cambiati.
  scoreReused     Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([jobRowId, candidateId])
  @@index([jobRowId])
}

/// Sessione di un marketplace che richiede login (1688, Taobao).
///
/// I cookie sono credenziali: stanno qui **solo cifrati** (AES-256-GCM) e non
/// vengono mai restituiti da un'API né scritti nei log. Di ogni sessione si
/// espone soltanto lo stato: quale account, quando scade, quando è stata usata.
model MarketplaceSession {
  id          String @id @default(cuid())
  marketplace String @unique

  /// Etichetta scelta dall'utente per riconoscere l'account.
  label String?

  /// Blob cifrato dei cookie, con il proprio vettore e tag di autenticazione.
  ciphertext String
  iv         String
  authTag    String
  /// Impronta del contenuto: dice se la sessione è cambiata senza esporla.
  digest     String

  /// Nomi dei cookie presenti, senza valori: utile per diagnosticare.
  cookieNames String[]
  /// Scadenza dichiarata dai cookie stessi, quando presente.
  expiresAt   DateTime?

  lastUsedAt   DateTime?
  lastFailedAt DateTime?
  /// Motivo dell'ultimo fallimento: serve a capire se va ricollegata.
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
